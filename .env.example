# ═══════════════════════════════════════════════
# TraceLab AI — Root Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════

# ─── Global ─────────────────────────────────────
NODE_ENV=development
TZ=America/Sao_Paulo

# ─── NestJS API ─────────────────────────────────
PORT=3000
APP_NAME=TraceLab

# ─── PostgreSQL ─────────────────────────────────
POSTGRES_USER=tracelab
POSTGRES_PASSWORD=tracelab_dev_pass
POSTGRES_DB=tracelab
DATABASE_URL=postgresql://tracelab:tracelab_dev_pass@localhost:5432/tracelab

# ─── Redis ──────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────
JWT_SECRET=change_me_in_production_jwt_secret_min_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_in_production_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── Cloudflare R2 (File Storage) ───────────────
# Get from: https://dash.cloudflare.com → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=<your_cloudflare_account_id>
CLOUDFLARE_R2_ACCESS_KEY_ID=<your_r2_access_key_id>
CLOUDFLARE_R2_SECRET_ACCESS_KEY=<your_r2_secret_access_key>
CLOUDFLARE_R2_BUCKET=tracelab-files
CLOUDFLARE_R2_PUBLIC_URL=https://<bucket>.r2.dev
# R2 endpoint follows the pattern:
CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com

# ─── AI Service ─────────────────────────────────
AI_SERVICE_URL=http://ai:8000
CONFIDENCE_THRESHOLD=0.85

# ─── Google Vision API (OCR) ────────────────────
# Provide path to GCP service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-key.json
# OR set individual values:
GOOGLE_PROJECT_ID=<your_gcp_project_id>
GOOGLE_CLIENT_EMAIL=<service_account_email>
GOOGLE_PRIVATE_KEY=<service_account_private_key>

# ─── AI Model ───────────────────────────────────
MODEL_PATH=/models/tracelab_classifier.pt

# ─── WhatsApp — Twilio ───────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=<your_twilio_account_sid>
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── Email — SendGrid ────────────────────────────
# Get from: https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=<your_sendgrid_api_key>
EMAIL_FROM=noreply@tracelab.app
EMAIL_FROM_NAME=TraceLab AI

# ─── CRM — HubSpot ──────────────────────────────
# Get from: https://app.hubspot.com → Settings → Integrations → Private Apps
HUBSPOT_ACCESS_TOKEN=<your_hubspot_private_app_token>
HUBSPOT_PORTAL_ID=<your_hubspot_portal_id>

# ─── Monitoring (Phase 6) ───────────────────────
GRAFANA_ADMIN_PASSWORD=admin_change_me
